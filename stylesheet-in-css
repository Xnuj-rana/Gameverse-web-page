body {
    margin: 0;
    font-family: Arial;
    background: linear-gradient(135deg, #141e30, #243b55);
    color: white;
}

header {
    background: black;
    padding: 15px;
    text-align: center;
    color: cyan;
    font-size: 24px;
}

#search {
    width: 60%;
    padding: 10px;
    margin: 20px auto;
    display: block;
    border-radius: 10px;
    border: none;
}

.games {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 20px;
}

.card {
    background: #1c1c1c;
    border-radius: 10px;
    overflow: hidden;
}

.card img {
    width: 100%;
    height: 180px;
}

.card h3 {
    margin: 10px;
}

.card a {
    display: block;
    margin: 10px;
    padding: 10px;
    background: cyan;
    color: black;
    text-align: center;
    text-decoration: none;
}

.container {
    width: 70%;
    margin: 30px auto;
    background: #1c1c1c;
    padding: 20px;
    border-radius: 10px;
}

.container img {
    width: 100%;
}

button {
    padding: 10px;
    margin: 5px;
    background: cyan;
    border: none;
    cursor: pointer;
}

.back {
    display: inline-block;
    margin-top: 20px;
    padding: 10px;
    background: cyan;
    color: black;
    text-decoration: none;
}
